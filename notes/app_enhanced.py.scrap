"""PySide6 Cosmic Console — ENHANCED VERSION
Client of NOVA.db with professional Qt widgets, charts, and visualizations.
Leverages full database richness (1,452+ records across 6 active tables).

Enhancements over original:
- QTableWidget for structured data views (replaces QTextEdit dumps)
- QGraphicsView for knowledge graph visualization (facts table)
- Custom waveforms and thumbnails for audio bites
- Search/filter capabilities on all list widgets
- Professional cosmic theming with gradients and neon accents
- Queue progress tracking with QProgressBar
- Job timeline visualization
- Data export functions (CSV/JSON)

Dependencies: PySide6, PyQtChart (optional), matplotlib, opencv-python-headless
"""

from __future__ import annotations

import sys
import json
import datetime
import re
from pathlib import Path
from typing import Optional, List, Dict, Any

# PySide6 imports
try:
    from PySide6.QtCore import (
        Qt, QTimer, QAbstractItemModel, QModelIndex, QSize, QPoint, Signal,
        QRect, QMargins, QBuffer, QByteArray, QVariant
    )
    from PySide6.QtGui import (
        QPixmap, QIcon, QFont, QPainter, QColor, QBrush, QLinearGradient,
        QTextFormat, QTextCursor, QPainterPath, QPalette
    )
    from PySide6.QtWidgets import (
        QApplication, QComboBox, QHBoxLayout, QVBoxLayout, QLabel, QLineEdit,
        QListWidget, QListWidgetItem, QMainWindow, QPushButton, QStackedWidget,
        QTextEdit, QTableView, QHeaderView, QProgressBar, QFrame, QWidget,
        QSplitter, QGraphicsView, QGraphicsScene, QGraphicsItem, QMessageBox,
        QDockWidget, QStatusBar, QSizePolicy, QDialog, QVBoxLayout,
        QGroupBox, QTabWidget, QSpinBox, QDoubleSpinBox, QCheckBox, QToolButton,
        QAction, QMenu, QScrollArea, QAbstractItemView, QSplitterHandle,
        QStyledItemDelegate, QTableWidget, QTableWidgetItem, QAbstractScrollArea
    )
except ImportError:
    print("PySide6 missing. pip install PySide6")
    return


