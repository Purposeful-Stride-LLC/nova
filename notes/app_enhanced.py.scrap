class EnhancedPalaceView(QTableView):
    """Improved Palace table viewer with sorting, filtering, and formatting."""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self.table_name = None
        
        # Style settings
        self.setStyleSheet("""
            QTableView {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                            stop:0 #0f0f23, stop:1 #1a1a2e);
                border: 2px solid #00d9ff;
                gridline-color: rgba(0, 217, 255, 0.15);
                selection-background-color: #0066cc;
                alternate-row-color: #13131f;
            }
            QTableView::item {
                padding: 4px;
                border-radius: 3px;
            }
            QHeaderView::section {
                background: #00d9ff;
                color: #000;
                font-weight: bold;
                padding: 6px;
                border: none;
            }
        """)
        
        self._filter_model = None
        self._original_model = None
        
    def set_table(self, table_name: str) -> bool:
        """Switch to displaying a different table."""
        if not table_name:
            return False
            
        self.table_name = table_name
        con = db.connect()
        
        try:
            # Get column info
            col_info = con.execute(
                f"PRAGMA table_info({table_name})"
            ).fetchall()
            
            # Set up model
            query = f"SELECT * FROM {table_name} LIMIT 300"
            rows = con.execute(query).fetchall()
            
            if not rows:
                con.close()
                return False
                
            cols = [col[1] for col in col_info]  # Column names
            
            # Build model data
            model_data = []
            for row in rows:
                item_row = {}
                for i, name in enumerate(cols):
                    val = row[i] if i < len(row) else ''
                    # Truncate long text
                    if isinstance(val, str) and len(val) > 80:
                        val = val[:77] + "..."
                    item_row[name] = val
                model_data.append(item_row)
            
            # Create custom model
            self._model = DataModel(model_data, cols)
            self.setModel(self._model)
            
            # Set column headers
            for i, col in enumerate(cols):
                header = QTableWidgetItem(col[:18])  # Truncate for header
                header.setFlags(header.flags() & ~Qt.ItemIsEditable)
                self.setHorizontalHeaderItem(i, header)
                
            # Configure view
            self.setColumnCount(len(cols))
            self.horizontalHeader().setSectionResizeMode(QHeaderView.Interactive)
            self.setSortingEnabled(True)
            self.setSelectionBehavior(QAbstractItemView.SelectRows)
            self.setSelectionMode(QAbstractItemView.ExtendedSelection)
            self.setAlternatingRowColors(True)
            
            con.close()
            return True
            
        except Exception as e:
            print(f"Error loading table {table_name}: {e}")
            con.close()
            return False
    
    def set_filter(self, text: str):
        """Filter rows by searching all columns."""
        if not text:
            # Show all rows
            for row in range(self.model().rowCount()):
                self.model().setData(
                    self.model().index(row, 0), 
                    Qt.DisplayRole, Qt.DisplayRole
                )
        else:
            filter_text = text.lower()
            for row in range(self.model().rowCount()):
                show_row = any(
                    filter_text in str(self.model().data(
                        self.model().index(row, col), Qt.DisplayRole
                    ) or '').lower()
                    for col in range(self.model().columnCount())
                )
                if show_row:
                    role = Qt.DisplayRole
                else:
                    role = Qt.NoRole
                
                self.model().setData(
                    self.model().index(row, 0),
                    '',
                    Qt.DisplayRole
                )


class KnowledgeGraphNode(QGraphicsItem):
    """Node for knowledge graph visualization."""
    
    def __init__(self, fact_id: int, title: str, body: str = ""):
        super().__init__()
        self.fact_id = fact_id
        self._title = title[:60]  # Truncate title
        self._body = body[:150] if body else ""  # Show first 150 chars
        
        # Node properties
        self._pos = None
        self._size = QSize(280, 80)
        self._color = QColor("#1a4d6c")
        
        # Create scene rectangle (invisible anchor)
        self.setFlag(QGraphicsItem.ItemIsMovable)
        self.setAcceptHoverEvents(True)
    
    def boundingRect(self) -> QRect:
        return QRect(self.pos(), QSize(280, 80))
    
    def paint(self, painter: QPainter, option: Qt.GraphicsItemRenderHint, widget) -> None:
        painter.setRenderHint(QPainter.Antialiasing)
        
        # Draw node background (rounded rect)
        pen = QPen(QColor("#00d9ff"), 2)
        path = QPainterPath()
        radius = 15
        x, y, w, h = self.boundingRect().x(), self.boundingRect().y(), 280, 80
        
        # Create rounded rectangle path
        path.moveTo(x + radius, y)
        path.lineTo(x + w - radius, y)
        path.quadraticTo(x + w, y + radius, x + w - radius, y + h - radius)
        path.lineTo(x + radius, y + h)
        path.quadraticTo(x, y + h - radius, x, y + radius)
        path.quadraticTo(x + radius, y, x + radius, y)
        
        painter.setPen(Qt.NoPen)
        brush = QBrush(QColor("#0a1f2d"))
        painter.fillPath(path, brush)
        
        # Draw border
        pen.setColor(QColor("#00d9ff"))
        painter.setPen(pen)
        painter.drawPath(path)
        
        # Draw title (white text)
        painter.setPen(QColor("#ffffff"))
        font = QFont("Arial", 12, QFont.Bold)
        painter.setFont(font)
        painter.drawText(self.boundingRect(), Qt.AlignCenter, self._title)
        
        # Draw body (light gray text)
        painter.setPen(QColor("#aaaaaa"))
        painter.setFont(QFont("Arial", 9))
        painter.drawText(
            QRect(x + 5, y + 30, 270, 40), 
            Qt.AlignCenter | Qt.TextWordWrap, 
            self._body
        )
    
    def hoverEnterEvent(self, event) -> None:
        if not self._pos:
            return
            
        color = QColor("#1a4d6c")
        if event->mouseButton() == Qt.LeftButton:
            self._color = QColor("#ff6b6b")
        else:
            # Restore original color


class ObservationsView(QTableView):
    """Structured table view for observations data."""
    
    def __init__(self, max_rows: int = 500):
        super().__init__()
        self.max_rows = max_rows
        self._populate()
        
        self.setStyleSheet("""
            QTableView {
                background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                            stop:0 #0f0f23, stop:1 #16213e);
                border: 2px solid #ff6b9d;
                gridline-color: rgba(255, 107, 157, 0.1);
            }
            QHeaderView::section {
                background: #ff6b9d;
                color: white;
            }
        """)
    
    def _populate(self):
        """Load observations from database."""
        con = db.connect()
        
        try:
            query = "SELECT * FROM observations ORDER BY id DESC LIMIT %s" % self.max_rows
            rows = con.execute(query).fetchall()
            
            if not rows:
                con.close()
                return
                
            # Convert to list of dicts for easier access
            self._rows = [dict(zip([desc[1] for desc in con.description], row)) 
                         for row in rows]
            
            # Set up model
            cols = ['id', 'zulu', 'source', 'ok']
            data = [{'col': r[col] for col in cols} for r in self._rows]
            
            self._model = EnhancedDataModel(data, cols)
            self.setModel(self._model)
            
            # Configure view
            self.setColumnCount(len(cols))
            self.horizontalHeader().setSectionResizeMode(QHeaderView.Interactive)
            self.setSortingEnabled(True)
            
        except Exception as e:
            print(f"Error loading observations: {e}")
            
        finally:
            con.close()


class BiteWaveformCanvas(QWidget):
    """Custom widget for displaying audio waveform thumbnails."""
    
    def __init__(self):
        super().__init__()
        self.path = None
        self.setMinimumSize(400, 200)
        
        # Style for dark background
        self.setStyleSheet("background: #0a0a14;")
        
    def set_audio_path(self, path: str):
        """Set the audio file path to display waveform for."""
        if path and Path(path).suffix.lower() in ['.wav', '.mp3']:
            try:
                # Simplified waveform generation (would use librosa/audio API in full)
                # For now, generate placeholder pattern based on filename length
                import hashlib
                hash_val = hashlib.md5(Path(path).read_bytes()).hexdigest()
                self.path = path
                
                # Draw simplified "waveform" based on hash
                painter = QPainter(self)
                painter.setRenderHint(QPainter.Antialiasing)
                
                # Background gradient
                grad = QLinearGradient(0, 0, 0, self.height())
                grad.setColorAt(0.0, QColor("#0f0f23"))
                grad.setColorAt(1.0, QColor("#1a1a2e"))
                painter.fillRect(self.rect(), grad)
                
                # Draw waveform bars (simplified)
                bar_height = self.height() / 16
                for i in range(8):
                    x = i * self.width() // 8 + 50
                    # Height based on hash
                    height = int(hash_val[i*2:(i+1)*2], 16) % (self.height() - bar_height)
                    
                    # Draw bar
                    brush = QBrush(QColor("#00d9ff"))
                    painter.fillRect(x, self.height() - height, 20, height, brush)
                    
                painter.end()
                
            except Exception as e:
                print(f"Error generating waveform for {path}: {e}")


class QueueTracker(QVBoxLayout):
    """Progress tracker for URL ingestion queue."""
    
    def __init__(self):
        super().__init__()
        
        self.progress_bar = QProgressBar()
        self.progress_bar.setTextVisible(True)
        self.progress_bar.setFormat("Ingest: %p% complete")
        self.progress_bar.setValue(0)
        
        self.status_label = QLabel("Ready to ingest URLs")
        self.status_label.setStyleSheet("color: #00d9ff; font-weight: bold; padding: 8px;")
        
        self.queue_list = QListView()
        self.queue_list.setFrameShape(QFrame.NoFrame)
        self.queue_list.setEditTriggers(QAbstractItemView.NoEditTriggers)
        self.queue_list.setSelectionMode(QAbstractItemView.SingleSelection)
        
        self.addWidgets()
    
    def addWidgets(self):
        """Add layout widgets."""
        # Progress section
        progress_group = QGroupBox("Ingestion Progress")
        progress_layout = QVBoxLayout(progress_group)
        progress_layout.addWidget(self.progress_bar)
        progress_layout.addWidget(self.status_label)
        
        # Queue list section
        list_group = QGroupBox("Pending URLs (Click to inspect)")
        list_layout = QVBoxLayout(list_group)
        list_layout.addWidget(QLabel("Queue"))
        list_layout.addWidget(self.queue_list)
        
        # Add to main layout
        self.addWidget(progress_group)
        self.addWidget(QFrame()))  # Spacer
        self.addWidget(list_group)
    
    def update_status(self, completed: int, total: int):
        """Update progress bar and status."""
        if total > 0:
            pct = (completed / total) * 100
            self.progress_bar.setValue(int(pct))
        
        if completed > total // 2:
            self.status_label.setText(f"Processing {completed}/{total} URLs...")
        elif completed >= total:
            self.status_label.setText("Queue drained successfully! ✅")


