class CosmicConsole(QMainWindow):
    """Enhanced NOVA Cosmic Console with professional Qt widgets."""
    
    def __init__(self):
        super().__init__()
        
        # Set window properties
        self.setWindowTitle("NOVA 1.8 — COSMIC CONSOLE [ENHANCED]")
        self.resize(1400, 900)
        
        # Central widget with main layout
        central = QWidget()
        self.setCentralWidget(central)
        
        main_layout = QHBoxLayout(central)
        main_layout.setContentsMargins(10, 5, 10, 5)
        
        # =======================================================================
        # COMMAND DECK PANEL (left sidebar)
        # =======================================================================
        
        deck = QWidget()
        deck.setObjectName("CommandDeck")
        deck.setFixedWidth(260)
        dlay = QVBoxLayout(deck)
        
        # Brand banner
        brand_path = Path(__file__).resolve().parents[3] / "ascii" / "brand" / "banner.jpg"
        if brand_path.exists():
            banner = QLabel()
            pixmap = QPixmap(str(brand_path)).scaled(240, 130)
            banner.setPixmap(pixmap)
            banner.setAlignment(Qt.AlignCenter)
            dlay.addWidget(banner)
        
        # Command tiles (from deck.json)
        deck_path = Path(__file__).with_name("deck.json")
        tiles = []
        if deck_path.exists():
            try:
                tiles = json.loads(deck_path.read_text(encoding="utf-8")).get("tiles", [])
            except:
                pass
        
        # Add semantic panel buttons (QStackedLayout replacement)
        panels = [
            ("Communications", "chat_w"),
            ("Knowledge", "knowledge"),  # Merged: facts + observations
            ("Operations", "ops"),
            ("Mission Records", "records"),
            ("Sonic Archive", "sonic"),  # Enhanced with waveform viewer
            ("Media Viewport", "view"),
            ("Spawn Status", "spawn"),
        ]
        
        self.stack = QStackedWidget()
        
        panel_widgets = {}
        for name, panel_id in panels:
            widget = self._create_panel(name, panel_id)
            if widget:
                panel_widgets[panel_id] = widget
                self.stack.addWidget(widget)
                
                # Add button to deck
                btn = QPushButton(name)
                btn.setFixedHeight(42)
                btn.setFont(QFont("Arial", 10))
                btn.setStyleSheet("""
                    QPushButton {
                        background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                                    stop:0 #0f0f23, stop:1 #1a1a2e);
                        border: 1px solid #00d9ff;
                        color: #00d9ff;
                        padding: 8px;
                        font-weight: bold;
                    }
                    QPushButton:hover {
                        background: #16213e;
                        border-color: #ff6b9d;
                    }
                """)
                btn.clicked.connect(lambda checked, idx=self.stack.widgetIndex(widget): None)
                dlay.addWidget(btn)
        
        if panel_widgets:
            self.stack.setCurrentWidget(panel_widgets.get("chat_w", self.stack.currentWidget()))
        
        # Status triggers section
        dlay.addWidget(QLabel("SOUND TRIGGERS"))
        dlay.addStretch()
        deck.setLayout(dlay)
        
        main_layout.addWidget(deck)
        
        # =======================================================================
        # MAIN PANEL AREA (right side, tabbed for panels)
        # =======================================================================
        
        self.tab_widget = QTabWidget()
        
        if panel_widgets:
            for panel_id, widget in panel_widgets.items():
                self.tab_widget.addTab(widget, panel_id)
        
        main_layout.addWidget(self.tab_widget, stretch=1)
        
        # =======================================================================
        # STATUS BAR (bottom)
        # =======================================================================
        
        status_bar = QStatusBar()
        self.setStatusBar(status_bar)
        
        # Global metrics display
        self.status_label = QLabel("Ready | Connections: 0 | Jobs: 0")
        self.status_label.setStyleSheet("color: #00d9ff; font-size: 11px; padding: 4px;")
        status_bar.addPermanentWidget(self.status_label)
        
        # Update metrics every 5 seconds
        QTimer.singleShot(5000, self._update_metrics)
        QTimer.timeout.connect(lambda: None)
        
        # =======================================================================
        # INITIALIZE PANELS
        # =======================================================================
        
        self._init_communications()
        self._init_knowledge()
        self._init_operations()
        self._init_records()
        self._init_sonic()
        self._init_viewport()
        self._init_spawn()
        
        # Set up refresh timer (4 second cadence)
        self.refresh_timer = QTimer()
        self.refresh_timer.timeout.connect(self._refresh_all)
        self.refresh_timer.start(4000)
        
        self._refresh_all()

    def _create_panel(self, name: str, panel_id: str) -> QWidget:
        """Factory for creating panel widgets."""
        return None  # Panels created in specific init methods
    
    def _init_communications(self):
        """Initialize Communications panel."""
        chat_widget = QWidget()
