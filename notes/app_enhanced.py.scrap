class EnhancedCommPanel(QFrame):
    """Communications panel with chat interface."""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self._setup_ui()
    
    def _setup_ui(self):
        """Set up chat interface components."""
        layout = QVBoxLayout(self)
        
        # Chat log
        self.chat_log = QTextEdit()
        self.chat_log.setReadOnly(True)
        self.chat_log.setMinimumHeight(200)
        self.chat_log.setStyleSheet("""
            QTextEdit {
                background: #0a0a14;
                color: #00d9ff;
                border: 1px solid #00d9ff;
                padding: 8px;
                font-family: Consolas, monospace;
            }
        """)
        
        # Chat input with send button
        input_layout = QHBoxLayout()
        self.chat_input = QLineEdit()
        self.chat_input.setPlaceholderText("Type message and press Enter...")
        self.chat_input.returnPressed.connect(self._send_message)
        
        send_btn = QPushButton("Send →")
        send_btn.setStyleSheet("""
            QPushButton {
                background: #00d9ff;
                color: white;
                padding: 6px 12px;
                font-weight: bold;
            }
            QPushButton:hover {
                background: #00b8e5;
            }
        """)
        
        input_layout.addWidget(self.chat_input)
        input_layout.addWidget(send_btn)
        
        # Model selector
        model_layout = QHBoxLayout()
        self.model_selector = QComboBox()
        try:
            tags = ollama_talk.tags() or []
        except:
            tags = ["llama3-groq-tool-use:8b", "qwen3:8b", "moondream"]
        
        for tag in tags:
            self.model_selector.addItem(tag)
        
        if "llama3-groq-tool-use:8b" in tags:
            self.model_selector.setCurrentText("llama3-groq-tool-use:8b")
        
        model_layout.addWidget(QLabel("Model:"))
        model_layout.addWidget(self.model_selector)
        
        # Add widgets to layout
        layout.addWidget(QLabel("ASTROCOMMS", styleSheet="color: #00d9ff; font-weight: bold;"))
        layout.addWidget(self.chat_log)
        layout.addLayout(input_layout)
        layout.addLayout(model_layout)
    
    def _send_message(self):
        """Handle send button click or Enter key."""
        text = self.chat_input.text().strip()
        if not text:
            return
        
        # Append to chat log
        timestamp = datetime.datetime.now().strftime("%H:%M:%S")
        self.chat_log.append(f"[{timestamp}] YOU: {text}")
        
        # Clear input and process message (simplified - would connect to NOVA brain)
        self.chat_input.clear()


# =============================================================================
# KNOWN ISSUES / LIMITATIONS
# =============================================================================

# Current app.py known issues identified in analysis:
# 1. All lists use QListWidget without styling or filtering
# 2. Single QTextEdit used as generic data dump (palace_view)
# 3. No visual hierarchy, charts, thumbnails, or progress indicators
# 4. Primitive "cosmic" aesthetic without Qt Chart/graph integration

# Enhancement strategy addresses these by:
# - Replacing QListWidgets with QTableWidget and QGraphicsView
# - Adding custom QStyledItemDelegate for formatting
# - Implementing search/filter on all list widgets
# - Creating dedicated waveform thumbnail generator
# - Adding QProgressBar for queue tracking
# - Professional theming with gradients and neon accents
